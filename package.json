{
  "name": "liveflux",
  "version": "0.0.0",
  "private": true,
  "description": "Type-safe, cache-integrated, reconnect-safe realtime streaming state for the frontend.",
  "license": "MIT",
  "author": {
    "name": "Bhavin Devamorari",
    "url": "https://bpdm.dev"
  },
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "size": "turbo run size",
    "check": "turbo run typecheck test build size",
    "e2e": "turbo run e2e --filter=e2e",
    "format": "prettier --write .",
    "ship": "bash scripts/ship.sh"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "prettier": "^3.4.0",
    "size-limit": "^11.1.6",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.5",
      "postcss": ">=8.5.23",
      "source-map-js": ">=1.2.2",
      "browserslist": ">=4.28.7",
      "baseline-browser-mapping": ">=2.11.0",
      "nanoid": ">=3.3.18",
      "js-yaml": ">=4.3.2"
    }
  }
}
